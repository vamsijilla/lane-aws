# deploy/.env: every setting the stack reads. Copy this file (cp env.aws.example .env), fill it in, never commit it.
# Values with $ in them (the password hash) must stay in single quotes.

# --- The site -------------------------------------------------------------------------------
# AWS: the Elastic IP as a name, e.g. 3-91-20-14.sslip.io (Caddy gets the certificate itself)
# Local rehearsal: http://localhost:8080 (and LANE_HTTP_PORT=8080 below)
LANE_SITE=3-91-20-14.sslip.io
LANE_CORS_ORIGINS=["https://3-91-20-14.sslip.io"]

# The password gate: one user, a bcrypt hash (deploy/gate.sh makes both and the cookie token)
LANE_GATE_USER=reviewer
LANE_GATE_HASH='$2a$14$replace.with.the.hash.from.gate.sh'
LANE_GATE_TOKEN=replace-with-64-random-hex-characters

# Ports Caddy publishes on the host
LANE_HTTP_PORT=80
LANE_HTTPS_PORT=443

# Images (deploy.sh sets these to the ECR repositories)
LANE_API_IMAGE=lane-api:local
LANE_WEB_IMAGE=lane-web:local

# --- The backend ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# RDS, with SSL required. Local rehearsal: postgresql+psycopg://lane:lane@postgres:5432/lane
LANE_DATABASE_URL=postgresql+psycopg://lane:PASSWORD@RDS-ENDPOINT:5432/lane?sslmode=require
LANE_RUN_MODE=queue
# The worker watches this inbox; nothing else may
LANE_MAILPIT_URL=http://mailpit:8025/mail

# Files: S3 through the instance role, so no keys here. Leave the endpoint empty for real S3.
# Local rehearsal: endpoint http://minio:9000, bucket lane, keys lane-local / lane-local-secret
LANE_BLOB_BACKEND=s3
LANE_S3_BUCKET=
LANE_S3_REGION=us-east-1
LANE_S3_ENDPOINT_URL=
LANE_S3_ACCESS_KEY_ID=
LANE_S3_SECRET_ACCESS_KEY=

# The expert review always asks before it spends (cached replays are free)
LANE_ANALYZE_AUTO_BUDGET_USD=0
