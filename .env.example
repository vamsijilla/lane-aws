# Anthropic API key used for classification, extraction and analysis.
ANTHROPIC_API_KEY=

# Where Lane keeps its database and stored attachments. Defaults to ./var
# LANE_DATA_DIR=./var

# Leave empty for SQLite in LANE_DATA_DIR, or name a Postgres database.
# LANE_DATABASE_URL=postgresql+psycopg://localhost:5433/lane

# Web app: where the API lives.
NEXT_PUBLIC_LANE_API_URL=http://localhost:8000

# Signs demo sign-in tokens. Set a long random value outside local development.
# LANE_SESSION_SECRET=

# Testing profile: run every model role on Haiku to keep spend low while testing. Quality of the
# expert review, the agent email and hard re-reads drops; remove for real runs.
# LANE_LLM_ESCALATION_MODEL=claude-haiku-5-5
# LANE_LLM_ANALYZE_MODEL=claude-haiku-5-5
# LANE_LLM_DRAFT_MODEL=claude-haiku-5-5
# LANE_LLM_ANALYZE_MAX_TOKENS=32000   # Haiku writes longer answers; 16000 cuts it off
# Re-running packets already processed: answer only from the model cache, spend nothing.
# LANE_LLM_CACHE_ONLY=true

# Files in S3 instead of LANE_DATA_DIR/blobs. Local: MinIO (make minio), with keys you choose.
# LANE_BLOB_BACKEND=s3
# LANE_S3_BUCKET=lane
# LANE_S3_ENDPOINT_URL=http://127.0.0.1:9000
# LANE_S3_ACCESS_KEY_ID=
# LANE_S3_SECRET_ACCESS_KEY=
# LANE_S3_SSE=aws:kms   # on AWS: encrypt every object with the bucket's KMS key
